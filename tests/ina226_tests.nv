// ina226_tests — the driver over a double of the part: a register file on
// an I2C bus that answers at 0x40 the way Texas Instruments' data sheet
// (SBOS547C, August 2026) says an INA226 does, with its power-on values,
// its read-only registers, a Current register and a Power register that
// the double computes from the Shunt, Bus and Calibration registers by the
// data sheet's Equations 3 and 4, a Mask/Enable register whose Conversion
// Ready and Alert Function flags clear when it is read, and a read that
// answers one register and nothing longer, since the sheet defines no more,
// so the framing, the settings and the readings are checked on the host,
// one transaction at a time.  The log keeps what the controller sent, in a
// form the tests compare.
//
// Log entries: a write is 1, the address, the bytes sent, -1; a read is 2,
// the address, the register, the count, -1.
//
// The numbers are the data sheet's Section 6.5.1 example: a 2 mohm shunt, a
// current step of 1 mA, CAL = 2560, a shunt voltage of 8000 steps, a bus
// voltage of 9584 steps, a current of 10000 steps and a power of 4792
// steps.

use std.test
use embedded_hal.{ BoardI2c, BoardGpio, I2cBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_power.{ MilliVolts }
use dev_current.{ MicroVolts, MicroAmps, MicroWatts, MonReading, CurrentMonitor }
use dev_id.{ DeviceId, Identifiable }
use ina226
use ina226.{ Ina226, Ina226Config, Ina226Cal, Ina226Flags, Ina226Reading, Ina226Port }

// ── The double ───────────────────────────────────────────────────────
//
// `regs` is the register file by register number, 16 bits each.  `ro`
// lists registers that ignore a write.  `st` is the double's state: 4 is 1
// when a part is there, 5 the address it answers at, 22 the I2C clock, 41
// the reads that still answer (-1 for all), 42 the writes that are still
// acknowledged (-1 for all), 43 is 1 when a reset leaves the registers as
// they are, 50 the status flags of Mask/Enable (bits 4, 3 and 2), 60 the
// resets seen, 99 the entries in the log.

struct Chip
    regs: HashMap<Int, Int>
    ro: HashMap<Int, Int>
    st: HashMap<Int, Int>
    log: HashMap<Int, Int>

fn at(m: HashMap<Int, Int>, k: Int) -> Int
    m.get(k) ?? 0

// The part at power-up: CONFIG 0x4127, the calibration and the alert
// registers 0, the manufacturer ID 0x5449 and the die ID 0x2260.
fn chip() -> Chip
    let c = Chip { regs: HashMap.new(), ro: HashMap.new(), st: HashMap.new(), log: HashMap.new() }
    c.regs.insert(0x00, 0x4127)
    c.regs.insert(0xFE, 0x5449)
    c.regs.insert(0xFF, 0x2260)
    c.st.insert(4, 1)
    c.st.insert(5, 0x40)
    c.st.insert(41, -1)
    c.st.insert(42, -1)
    c

// Appends a value to the log.
fn log_push(c: Chip, v: Int)
    let n = at(c.st, 99)
    c.log.insert(n, v)
    c.st.insert(99, n + 1)

// Empties the log.
fn log_clear(c: Chip)
    c.st.insert(99, 0)

// A signed 16-bit register.
fn signed(v: Int) -> Int
    dev_bus.dev_sign_extend(v, 16)

// The Current register: the shunt register times the calibration over 2048
// (Equation 3), truncated toward zero.
fn current_reg(c: Chip) -> Int
    (signed(at(c.regs, 0x01)) * at(c.regs, 0x05)) / 2048

// The power-on reset: CONFIG, CAL, MASK/ENABLE and the limit return to
// their power-on values unless the double was told to ignore the reset.
fn reset_regs(c: Chip)
    c.st.insert(60, at(c.st, 60) + 1)
    if at(c.st, 43) == 1
        return
    c.regs.insert(0x00, 0x4127)
    c.regs.insert(0x05, 0)
    c.regs.insert(0x06, 0)
    c.regs.insert(0x07, 0)

// The 16-bit value the part answers at `reg`.  Reading Mask/Enable clears
// the Conversion Ready and Alert Function flags.
fn chip_reg(c: Chip, reg: Int) -> Int
    if reg == 0x04
        return current_reg(c) & 0xFFFF
    if reg == 0x03
        var cur = current_reg(c)
        if cur < 0
            cur = 0 - cur
        return ((cur * (at(c.regs, 0x02) & 0x7FFF)) / 20000) & 0xFFFF
    if reg == 0x06
        let v = at(c.regs, 0x06) | at(c.st, 50)
        c.st.insert(50, at(c.st, 50) & 0xFFE7)
        return v
    at(c.regs, reg)

// A write to one register: a read-only register or one the test froze
// ignores it; CONFIG keeps bit 14 and resets on bit 15; CAL keeps 15 bits;
// Mask/Enable keeps the function and the two configuration bits.
fn chip_write(c: Chip, reg: Int, v: Int)
    if at(c.ro, reg) == 1
        return
    if reg == 0x00
        if (v & 0x8000) != 0
            reset_regs(c)
            return
        c.regs.insert(0x00, (v & 0x7FFF) | 0x4000)
        return
    if reg == 0x05
        c.regs.insert(0x05, v & 0x7FFF)
    if reg == 0x06
        c.regs.insert(0x06, v & 0xFC03)
    if reg == 0x07
        c.regs.insert(0x07, v & 0xFFFF)

struct FakeI2c
    c: Chip

impl I2cBus for FakeI2c
    fn init(self, freq: Int) [hw]
        self.c.st.insert(22, freq)

    fn write(self, addr: Int, data: [u8]) -> Bool [hw]
        log_push(self.c, 1)
        log_push(self.c, addr)
        for b in data
            log_push(self.c, b as Int)
        log_push(self.c, -1)
        if addr != at(self.c.st, 5) or at(self.c.st, 4) == 0 or data.len() != 3
            return false
        let left = at(self.c.st, 42)
        if left == 0
            return false
        if left > 0
            self.c.st.insert(42, left - 1)
        chip_write(self.c, data[0] as Int, ((data[1] as Int) << 8) | (data[2] as Int))
        true

    fn read(self, addr: Int, n: Int) -> ?[u8] [hw]
        None

    // A read answers one register, two bytes.  The sheet defines no read
    // that runs on into the next register, so the double refuses one.
    @tier(app)
    fn write_read(self, addr: Int, tx: [u8], n: Int) -> ?[u8] [hw]
        log_push(self.c, 2)
        log_push(self.c, addr)
        log_push(self.c, tx[0] as Int)
        log_push(self.c, n)
        log_push(self.c, -1)
        if addr != at(self.c.st, 5) or at(self.c.st, 4) == 0 or n != 2
            return None
        let left = at(self.c.st, 41)
        if left == 0
            return None
        if left > 0
            self.c.st.insert(41, left - 1)
        let v = chip_reg(self.c, tx[0] as Int)
        var out: [u8] = []
        list.push(out, ((v >> 8) & 0xFF) as u8)
        list.push(out, (v & 0xFF) as u8)
        Some(out)

// The GPIO double records the level and the mode of each pin.
struct FakePins
    levels: HashMap<Int, Int>
    modes: HashMap<Int, Int>

impl GpioOut for FakePins
    fn mode(self, pin: Int, dir: Int) [hw]
        self.modes.insert(pin, dir)

    fn set(self, pin: Int, val: Int) [hw]
        self.levels.insert(pin, val)

    fn get(self, pin: Int) -> Int [hw]
        at(self.levels, pin)

@tier(app)
fn pins() -> FakePins
    FakePins { levels: HashMap.new(), modes: HashMap.new() }

// The port, as a type that holds a bus implements it: every method is the
// package's own function over the double.
struct Dut
    bus: FakeI2c
    pins: FakePins
    w: DeviceWiring

impl Ina226Port for Dut
    fn setup(self) -> Bool [hw]
        ina226.i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        ina226.i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_regs(self, reg: Int, src: DevBytes) -> Bool [hw]
        ina226.i2c_write(self.bus, self.w, reg, src)

    fn alert_level(self) -> Int [hw]
        ina226.alert_level_of(self.pins, self.w)

// The board's wiring: the part at 0x40, ALERT on pin 9.
fn wiring() -> DeviceWiring
    dev_bus.wiring_irq(dev_bus.wiring_i2c(0, 0x40), 9)

fn dut(c: Chip) -> Dut
    Dut { bus: FakeI2c { c: c }, pins: pins(), w: wiring() }

// Asserts the log holds exactly `want`, then empties it.
fn log_is(c: Chip, want: [Int])
    test.assert_eq(at(c.st, 99), want.len())
    for i in 0..want.len()
        test.assert_eq(at(c.log, i), want[i])
    log_clear(c)

fn int_or(o: ?Int) -> Int
    match o
        Some(v) => v
        None => -999999
fn config_or(o: ?Ina226Config) -> Ina226Config
    match o
        Some(c) => c
        None => Ina226Config { avg: -1, vbus_ct: -1, vshunt_ct: -1, mode: -1 }

fn mv_or(o: ?MilliVolts) -> Int
    match o
        Some(v) => v.mv
        None => -999999

fn reading_or(o: ?Ina226Reading) -> Ina226Reading
    match o
        Some(r) => r
        None => Ina226Reading { reading: MonReading { bus: MilliVolts { mv: -1 }, shunt: MicroVolts { uv: -1 },
                                                      current: MicroAmps { ua: -1 }, power: MicroWatts { uw: -1 },
                                                      overflow: false },
                                flags: Ina226Flags { alert: false, ready: false, overflow: false } }

fn flags_or(o: ?Ina226Flags) -> Ina226Flags
    match o
        Some(f) => f
        None => Ina226Flags { alert: false, ready: false, overflow: false }

// The data sheet's example: a 2 mohm shunt carrying 10 A at 11.98 V, with
// the calibration for a 1 mA step programmed.
fn example(c: Chip, d: Dut)
    c.regs.insert(0x01, 8000)
    c.regs.insert(0x02, 9584)
    test.assert(ina226.cal_write(d, 2000, 32768000))
    log_clear(c)

// ── The constants and the tables ─────────────────────────────────────

@test
fn test_the_constants_are_the_data_sheets() [io, hw]
    test.assert_eq(ina226.MANUFACTURER_ID, 0x5449)
    test.assert_eq(ina226.DIE_DID, 0x226)
    test.assert_eq(ina226.CONFIG_POR, 0x4127)
    test.assert_eq(ina226.SHUNT_FULL_SCALE_UV, 81920)
    test.assert_eq(ina226.MODE_POWER_DOWN, 0)
    test.assert_eq(ina226.MODE_SHUNT_TRIGGERED, 1)
    test.assert_eq(ina226.MODE_BUS_TRIGGERED, 2)
    test.assert_eq(ina226.MODE_BOTH_TRIGGERED, 3)
    test.assert_eq(ina226.MODE_SHUNT_CONTINUOUS, 5)
    test.assert_eq(ina226.MODE_BUS_CONTINUOUS, 6)
    test.assert_eq(ina226.MODE_BOTH_CONTINUOUS, 7)
    test.assert_eq(ina226.ALERT_NONE, 0)
    test.assert_eq(ina226.ALERT_SHUNT_OVER, 1)
    test.assert_eq(ina226.ALERT_SHUNT_UNDER, 2)
    test.assert_eq(ina226.ALERT_BUS_OVER, 3)
    test.assert_eq(ina226.ALERT_BUS_UNDER, 4)
    test.assert_eq(ina226.ALERT_POWER_OVER, 5)

@test
fn test_the_averages_follow_table_7_3() [io, hw]
    test.assert_eq(ina226.averages_of(0), 1)
    test.assert_eq(ina226.averages_of(1), 4)
    test.assert_eq(ina226.averages_of(2), 16)
    test.assert_eq(ina226.averages_of(3), 64)
    test.assert_eq(ina226.averages_of(4), 128)
    test.assert_eq(ina226.averages_of(5), 256)
    test.assert_eq(ina226.averages_of(6), 512)
    test.assert_eq(ina226.averages_of(7), 1024)
    test.assert_eq(ina226.averages_of(8), 0)
    test.assert_eq(ina226.averages_of(-1), 0)

@test
fn test_the_conversion_times_follow_tables_7_4_and_7_5() [io, hw]
    test.assert_eq(ina226.conversion_time_us(0), 140)
    test.assert_eq(ina226.conversion_time_us(1), 204)
    test.assert_eq(ina226.conversion_time_us(2), 332)
    test.assert_eq(ina226.conversion_time_us(3), 588)
    test.assert_eq(ina226.conversion_time_us(4), 1100)
    test.assert_eq(ina226.conversion_time_us(5), 2116)
    test.assert_eq(ina226.conversion_time_us(6), 4156)
    test.assert_eq(ina226.conversion_time_us(7), 8244)
    test.assert_eq(ina226.conversion_time_us(8), -1)
    test.assert_eq(ina226.conversion_time_us(-1), -1)

@test
fn test_the_power_on_config_is_continuous_at_1_1_ms_with_one_average() [io, hw]
    let c = ina226.config_of(0x4127)
    test.assert_eq(c.avg, 0)
    test.assert_eq(c.vbus_ct, 4)
    test.assert_eq(c.vshunt_ct, 4)
    test.assert_eq(c.mode, 7)
    test.assert_eq(ina226.config_bits(c), 0x4127)
    // The reset bit is not a field; bit 14 is set as the part reads it.
    let d = Ina226Config { avg: 7, vbus_ct: 7, vshunt_ct: 7, mode: 7 }
    test.assert_eq(ina226.config_bits(d), 0x4FFF)

@test
fn test_the_time_of_a_result_follows_the_mode() [io, hw]
    // Both signals, one average, 1.1 ms each.
    test.assert_eq(ina226.result_us(Ina226Config { avg: 0, vbus_ct: 4, vshunt_ct: 4, mode: 3 }), 2200)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 0, vbus_ct: 4, vshunt_ct: 4, mode: 7 }), 2200)
    // Sixteen averages of 588 us and 332 us.
    test.assert_eq(ina226.result_us(Ina226Config { avg: 2, vbus_ct: 3, vshunt_ct: 2, mode: 3 }), 14720)
    // The shunt alone, the bus alone, and power-down.
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 2, mode: 1 }), 1328)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 2, mode: 5 }), 1328)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 2, mode: 2 }), 2352)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 2, mode: 6 }), 2352)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 2, mode: 0 }), 0)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 2, mode: 4 }), 0)
    // A field outside its range.
    test.assert_eq(ina226.result_us(Ina226Config { avg: 8, vbus_ct: 3, vshunt_ct: 2, mode: 3 }), -1)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 8, vshunt_ct: 2, mode: 3 }), -1)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 8, mode: 3 }), -1)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 2, mode: 8 }), -1)
    test.assert_eq(ina226.result_us(Ina226Config { avg: 1, vbus_ct: 3, vshunt_ct: 2, mode: -1 }), -1)

@test
fn test_only_modes_5_to_7_convert_by_themselves() [io, hw]
    for m in 0..5
        test.assert(not ina226.mode_is_continuous(m))
    test.assert(ina226.mode_is_continuous(5))
    test.assert(ina226.mode_is_continuous(6))
    test.assert(ina226.mode_is_continuous(7))
    test.assert(not ina226.mode_is_continuous(8))

@test
fn test_the_address_follows_table_6_2() [io, hw]
    test.assert_eq(ina226.address_of(0, 0), 0x40)
    test.assert_eq(ina226.address_of(0, 1), 0x41)
    test.assert_eq(ina226.address_of(0, 2), 0x42)
    test.assert_eq(ina226.address_of(0, 3), 0x43)
    test.assert_eq(ina226.address_of(1, 0), 0x44)
    test.assert_eq(ina226.address_of(2, 0), 0x48)
    test.assert_eq(ina226.address_of(2, 3), 0x4B)
    test.assert_eq(ina226.address_of(3, 0), 0x4C)
    test.assert_eq(ina226.address_of(3, 3), 0x4F)
    test.assert_eq(ina226.address_of(4, 0), -1)
    test.assert_eq(ina226.address_of(0, 4), -1)
    test.assert_eq(ina226.address_of(-1, 0), -1)
    test.assert_eq(ina226.address_of(0, -1), -1)

// ── The calibration and the conversions ──────────────────────────────

@test
fn test_the_calibration_of_the_data_sheets_example_is_2560() [io, hw]
    // 1 mA a step, 2 mohm: 0.00512 / (0.001 * 0.002).
    test.assert_eq(ina226.cal_for(2000, 1000), 2560)
    test.assert_eq(ina226.cal_for(0, 1000), 0)
    test.assert_eq(ina226.cal_for(-1, 1000), 0)
    test.assert_eq(ina226.cal_for(2000, 0), 0)
    test.assert_eq(ina226.cal_for(2000, -1), 0)
    // The step is truncated: 5120000000 / (458 * 2000) = 5589.5.
    test.assert_eq(ina226.cal_for(2000, 458), 5589)

@test
fn test_the_current_step_covers_the_largest_current_over_15_bits() [io, hw]
    // 15 A over 2^15 is 457.7 uA, which rounds up to 458.
    test.assert_eq(ina226.current_lsb_for(2000, 15000000), 458)
    // 32.768 A over 2^15 is exactly 1000.
    test.assert_eq(ina226.current_lsb_for(2000, 32768000), 1000)
    // A tiny current is still a step of 1.
    test.assert_eq(ina226.current_lsb_for(100000, 1), 2)
    // A tiny shunt raises the step until the calibration fits 15 bits.
    test.assert_eq(ina226.current_lsb_for(10, 1000000), 15626)
    test.assert_eq(ina226.current_lsb_for(0, 1000000), 0)
    test.assert_eq(ina226.current_lsb_for(1000, 0), 0)

@test
fn test_a_calibration_for_a_shunt_and_a_largest_current() [io, hw]
    let a = ina226.calibration(2000, 32768000)
    test.assert_eq(a.cal, 2560)
    test.assert_eq(a.current_lsb_ua, 1000)
    let b = ina226.calibration(2000, 15000000)
    test.assert_eq(b.cal, 5589)
    test.assert_eq(b.current_lsb_ua, 458)
    // A 0.1 ohm breakout shunt and 800 mA.
    let k = ina226.calibration(100000, 800000)
    test.assert_eq(k.current_lsb_ua, 25)
    test.assert_eq(k.cal, 2048)
    let t = ina226.calibration(10, 1000000)
    test.assert_eq(t.cal, 32765)
    test.assert_eq(t.current_lsb_ua, 15626)

@test
fn test_a_shunt_the_part_cannot_scale_to_has_no_calibration() [io, hw]
    // 1 A across 0.1 ohm is 100 mV, past the 81.92 mV the part measures.
    test.assert_eq(ina226.calibration(100000, 1000000).cal, 0)
    test.assert_eq(ina226.calibration(0, 1000).cal, 0)
    test.assert_eq(ina226.calibration(1000, 0).cal, 0)
    // A resistance so large that no step gives a calibration of 1.
    test.assert_eq(ina226.calibration(5200000000, 1).cal, 0)

@test
fn test_the_registers_mean_what_the_data_sheets_example_says() [io, hw]
    test.assert_eq(ina226.shunt_uv_of(8000), 20000)
    // -80 mV is 0x8300 in two's complement (Section 7.1.2).
    test.assert_eq(ina226.shunt_uv_of(0x8300), -80000)
    test.assert_eq(ina226.shunt_uv_of(1), 2)
    test.assert_eq(ina226.bus_mv_of(9584), 11980)
    test.assert_eq(ina226.bus_mv_of(0x8000 | 9584), 11980)
    test.assert_eq(ina226.current_ua_of(10000, 2560, 2000), 10000000)
    test.assert_eq(ina226.current_ua_of(0xFFFF, 2560, 2000), -1000)
    test.assert_eq(ina226.current_ua_of(10000, 0, 2000), 0)
    test.assert_eq(ina226.current_ua_of(10000, 2560, 0), 0)
    test.assert_eq(ina226.power_uw_of(4792, 2560, 2000), 119800000)
    test.assert_eq(ina226.power_uw_of(4792, 0, 2000), 0)
    test.assert_eq(ina226.power_uw_of(4792, 2560, 0), 0)

@test
fn test_the_current_uses_the_real_step_not_the_one_asked_for() [io, hw]
    // CAL = 5589 for a 458 uA step at 2 mohm: the real step is
    // 5120000000 / (5589 * 2000) = 458.04 uA, so 1000 steps are
    // 458 042 uA, not 458 000.
    test.assert_eq(ina226.current_ua_of(1000, 5589, 2000), 458042)

@test
fn test_the_flags_of_mask_enable() [io, hw]
    let f = ina226.flags_of(0x0000)
    test.assert(not f.alert)
    test.assert(not f.ready)
    test.assert(not f.overflow)
    test.assert(ina226.flags_of(0x0010).alert)
    test.assert(ina226.flags_of(0x0008).ready)
    test.assert(ina226.flags_of(0x0004).overflow)
    test.assert(not ina226.flags_of(0xFFE3).alert)
    test.assert(not ina226.flags_of(0xFFE3).ready)
    test.assert(not ina226.flags_of(0xFFE3).overflow)

@test
fn test_the_alert_limits_are_in_the_registers_steps() [io, hw]
    test.assert_eq(ina226.shunt_limit_raw(20000), 8000)
    test.assert_eq(ina226.shunt_limit_raw(-80000), 0x8300)
    test.assert_eq(ina226.bus_limit_raw(11980), 9584)
    test.assert_eq(ina226.bus_limit_raw(36000), 28800)
    test.assert_eq(ina226.power_limit_raw(119800000, 2560, 2000), 4792)
    test.assert_eq(ina226.power_limit_raw(119800000, 0, 2000), 0)
    test.assert_eq(ina226.power_limit_raw(119800000, 2560, 0), 0)

// ── The bus ──────────────────────────────────────────────────────────

@test
fn test_a_read_is_the_pointer_then_a_repeated_start_and_two_bytes() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert_eq(int_or(ina226.reg_read(d, 0xFE)), 0x5449)
    log_is(c, [2, 0x40, 0xFE, 2, -1])

@test
fn test_a_write_is_the_pointer_then_the_high_byte_then_the_low() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(ina226.reg_write(d, 0x07, 0x1234))
    log_is(c, [1, 0x40, 0x07, 0x12, 0x34, -1])
    test.assert_eq(at(c.regs, 0x07), 0x1234)

@test
fn test_a_set_register_is_read_back_under_a_mask() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(ina226.reg_set(d, 0x07, 0xBEEF, 0xFFFF))
    log_is(c, [1, 0x40, 0x07, 0xBE, 0xEF, -1, 2, 0x40, 0x07, 2, -1])
    // A register that ignores the write differs from what was written.
    c.ro.insert(0x07, 1)
    test.assert(not ina226.reg_set(d, 0x07, 0x1111, 0xFFFF))
    // Bits outside the mask are not compared: the register holds 0xBE00.
    c.regs.insert(0x07, 0xBE00)
    test.assert(ina226.reg_set(d, 0x07, 0xBEEF, 0xFF00))
    test.assert(not ina226.reg_set(d, 0x07, 0xBEEF, 0xFFFF))
    c.ro.insert(0x07, 0)
    // A write the part refuses, and a read-back it does not answer.
    c.st.insert(42, 0)
    test.assert(not ina226.reg_set(d, 0x07, 0x2222, 0xFFFF))
    c.st.insert(42, 1)
    c.st.insert(41, 0)
    test.assert(not ina226.reg_set(d, 0x07, 0x2222, 0xFFFF))

@test
fn test_a_read_longer_than_one_register_is_not_something_the_part_defines() [io, hw]
    // The double refuses it, which is why the driver never makes one.
    let c = chip()
    let d = dut(c)
    var b: DevBytes = Vec.new()
    test.assert(not d.read_regs(0x01, 4, var b))

@test
fn test_a_part_that_is_not_there_does_not_answer() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = dut(c)
    test.assert(ina226.reg_read(d, 0x00) == None)
    test.assert(not ina226.reg_write(d, 0x00, 1))
    test.assert(ina226.manufacturer_read(d) == None)
    test.assert(ina226.die_read(d) == None)
    test.assert(ina226.id_read(d) == None)
    test.assert(ina226.config_read(d) == None)
    test.assert(ina226.cal_read(d) == None)
    test.assert(ina226.bus_read(d) == None)
    test.assert(ina226.reading_with_flags(d, 2000) == None)
    test.assert(ina226.reading_of(d, 2000) == None)
    test.assert(ina226.flags_read(d) == None)
    test.assert(not ina226.conversion_ready(d))
    test.assert_eq(ina226.convert_start(d), -1)
    test.assert(not ina226.start(d))

@test
fn test_the_part_answers_only_at_its_own_address() [io, hw]
    let c = chip()
    c.st.insert(5, 0x41)
    let d = dut(c)
    test.assert(ina226.reg_read(d, 0x00) == None)
    let e = Dut { bus: FakeI2c { c: c }, pins: pins(), w: dev_bus.wiring_i2c(0, 0x41) }
    test.assert_eq(int_or(ina226.reg_read(e, 0x00)), 0x4127)

@test
fn test_a_wiring_with_no_address_is_not_an_i2c_part() [io, hw]
    let c = chip()
    let d = Dut { bus: FakeI2c { c: c }, pins: pins(), w: dev_bus.wiring_spi(0, 5) }
    test.assert(not d.setup())
    var b: DevBytes = Vec.new()
    test.assert(not d.read_regs(0x00, 2, var b))
    test.assert(not ina226.start(d))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_setup_makes_the_alert_pin_an_input_and_the_bus_fast() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(d.setup())
    test.assert_eq(at(c.st, 22), 400000)
    test.assert_eq(at(d.pins.modes, 9), 0)
    // A wiring with no alert pin touches no pin.
    let e = Dut { bus: FakeI2c { c: c }, pins: pins(), w: dev_bus.wiring_i2c(0, 0x40) }
    test.assert(e.setup())
    test.assert_eq(e.pins.modes.len(), 0)

@test
fn test_the_alert_pin_level() [io, hw]
    let c = chip()
    let d = dut(c)
    d.pins.levels.insert(9, 1)
    test.assert_eq(d.alert_level(), 1)
    d.pins.levels.insert(9, 0)
    test.assert_eq(d.alert_level(), 0)
    test.assert_eq(ina226.alert_level_of(d.pins, dev_bus.wiring_i2c(0, 0x40)), -1)

// ── Identity and bring-up ────────────────────────────────────────────

@test
fn test_the_identity_is_the_manufacturer_and_the_die() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert_eq(int_or(ina226.manufacturer_read(d)), 0x5449)
    test.assert_eq(int_or(ina226.die_read(d)), 0x2260)
    match ina226.id_read(d)
        Some(i) =>
            test.assert_eq(i.who, 0x226)
            test.assert(i.rev == Some(0))
        None => test.assert(false)
    // Revision 1 is the other die COO.
    c.regs.insert(0xFF, 0x2261)
    match ina226.id_read(d)
        Some(i) => test.assert(i.rev == Some(1))
        None => test.assert(false)

@test
fn test_the_identity_matches_only_the_ina226() [io, hw]
    test.assert(ina226.id_matches(0x5449, 0x2260))
    test.assert(ina226.id_matches(0x5449, 0x2261))
    test.assert(not ina226.id_matches(0x5448, 0x2260))
    test.assert(not ina226.id_matches(0x5449, 0x3000))
    test.assert(not ina226.id_matches(0x0000, 0x0000))
    let c = chip()
    let d = dut(c)
    c.regs.insert(0xFF, 0x3000)
    test.assert(ina226.id_read(d) == None)
    c.regs.insert(0xFF, 0x2260)
    c.regs.insert(0xFE, 0x0000)
    test.assert(ina226.id_read(d) == None)

@test
fn test_a_part_that_leaves_between_the_two_id_reads_has_no_identity() [io, hw]
    let c = chip()
    let d = dut(c)
    c.st.insert(41, 1)
    test.assert(ina226.id_read(d) == None)

@test
fn test_the_bring_up_checks_the_identity_resets_and_checks_config() [io, hw]
    let c = chip()
    let d = dut(c)
    // A part someone configured: the reset brings it back.
    c.regs.insert(0x00, 0x4A55)
    c.regs.insert(0x05, 2560)
    test.assert(ina226.start(d))
    test.assert_eq(at(c.st, 60), 1)
    test.assert_eq(at(c.regs, 0x00), 0x4127)
    test.assert_eq(at(c.regs, 0x05), 0)
    test.assert_eq(at(c.st, 22), 400000)
    log_is(c, [2, 0x40, 0xFE, 2, -1, 2, 0x40, 0xFF, 2, -1, 1, 0x40, 0x00, 0xC1, 0x27, -1, 2, 0x40, 0x00, 2, -1])

@test
fn test_the_bring_up_stops_at_each_refusal() [io, hw]
    // Not an INA226.
    let c = chip()
    c.regs.insert(0xFE, 0x1234)
    let d = dut(c)
    test.assert(not ina226.start(d))
    test.assert_eq(at(c.st, 60), 0)
    // A part that does not acknowledge the reset.
    let e = chip()
    let f = dut(e)
    e.st.insert(42, 0)
    test.assert(not ina226.start(f))
    // A part that ignores the reset and keeps its configuration.
    let g = chip()
    let h = dut(g)
    g.st.insert(43, 1)
    g.regs.insert(0x00, 0x4A55)
    test.assert(not ina226.start(h))
    test.assert_eq(at(g.st, 60), 1)

// ── The configuration ────────────────────────────────────────────────

@test
fn test_a_config_write_is_read_back() [io, hw]
    let c = chip()
    let d = dut(c)
    let f = Ina226Config { avg: 3, vbus_ct: 5, vshunt_ct: 6, mode: 3 }
    test.assert(ina226.config_write(d, f))
    log_is(c, [1, 0x40, 0x00, 0x47, 0x73, -1, 2, 0x40, 0x00, 2, -1])
    let g = config_or(ina226.config_read(d))
    test.assert_eq(g.avg, 3)
    test.assert_eq(g.vbus_ct, 5)
    test.assert_eq(g.vshunt_ct, 6)
    test.assert_eq(g.mode, 3)

@test
fn test_a_config_field_outside_its_range_is_refused_and_sends_nothing() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(not ina226.config_write(d, Ina226Config { avg: 8, vbus_ct: 0, vshunt_ct: 0, mode: 0 }))
    test.assert(not ina226.config_write(d, Ina226Config { avg: -1, vbus_ct: 0, vshunt_ct: 0, mode: 0 }))
    test.assert(not ina226.config_write(d, Ina226Config { avg: 0, vbus_ct: 8, vshunt_ct: 0, mode: 0 }))
    test.assert(not ina226.config_write(d, Ina226Config { avg: 0, vbus_ct: -1, vshunt_ct: 0, mode: 0 }))
    test.assert(not ina226.config_write(d, Ina226Config { avg: 0, vbus_ct: 0, vshunt_ct: 8, mode: 0 }))
    test.assert(not ina226.config_write(d, Ina226Config { avg: 0, vbus_ct: 0, vshunt_ct: -1, mode: 0 }))
    test.assert(not ina226.config_write(d, Ina226Config { avg: 0, vbus_ct: 0, vshunt_ct: 0, mode: 8 }))
    test.assert(not ina226.config_write(d, Ina226Config { avg: 0, vbus_ct: 0, vshunt_ct: 0, mode: -1 }))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_each_config_setter_keeps_the_other_fields() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(ina226.averaging_write(d, 4))
    test.assert_eq(at(c.regs, 0x00), 0x4927)
    test.assert(ina226.conversion_times_write(d, 2, 3))
    test.assert_eq(at(c.regs, 0x00), 0x489F)
    test.assert(ina226.mode_write(d, 5))
    test.assert_eq(at(c.regs, 0x00), 0x489D)
    // A value outside the range is refused by the write after the read.
    test.assert(not ina226.averaging_write(d, 8))
    test.assert(not ina226.conversion_times_write(d, 8, 0))
    test.assert(not ina226.mode_write(d, 8))
    test.assert_eq(at(c.regs, 0x00), 0x489D)

@test
fn test_a_config_setter_stops_when_the_part_does_not_answer() [io, hw]
    let c = chip()
    let d = dut(c)
    c.st.insert(41, 0)
    test.assert(not ina226.averaging_write(d, 1))
    test.assert(not ina226.conversion_times_write(d, 1, 1))
    test.assert(not ina226.mode_write(d, 1))
    test.assert_eq(at(c.regs, 0x00), 0x4127)

@test
fn test_a_config_the_part_does_not_hold_is_reported() [io, hw]
    let c = chip()
    let d = dut(c)
    c.ro.insert(0x00, 1)
    test.assert(not ina226.config_write(d, Ina226Config { avg: 1, vbus_ct: 4, vshunt_ct: 4, mode: 7 }))

@test
fn test_the_reset_writes_the_reset_bit_with_the_power_on_value() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x05, 99)
    test.assert(ina226.reset(d))
    log_is(c, [1, 0x40, 0x00, 0xC1, 0x27, -1])
    test.assert_eq(at(c.regs, 0x05), 0)
    c.st.insert(42, 0)
    test.assert(not ina226.reset(d))

// ── The calibration through the bus ──────────────────────────────────

@test
fn test_the_calibration_is_written_and_read_back() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(ina226.cal_write(d, 2000, 32768000))
    log_is(c, [1, 0x40, 0x05, 0x0A, 0x00, -1, 2, 0x40, 0x05, 2, -1])
    test.assert_eq(int_or(ina226.cal_read(d)), 2560)

@test
fn test_a_shunt_that_does_not_fit_sends_nothing() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(not ina226.cal_write(d, 100000, 1000000))
    test.assert(not ina226.cal_write(d, 0, 1000))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_calibration_the_part_does_not_hold_is_reported() [io, hw]
    let c = chip()
    let d = dut(c)
    c.ro.insert(0x05, 1)
    test.assert(not ina226.cal_write(d, 2000, 32768000))

// ── Readings ─────────────────────────────────────────────────────────

@test
fn test_the_data_sheets_example_reads_10_amps_and_119_8_watts() [io, hw]
    let c = chip()
    let d = dut(c)
    example(c, d)
    // The double computes the Current and Power registers by Equations 3
    // and 4: 10000 and 4792.
    test.assert_eq(int_or(ina226.reg_read(d, 0x04)), 10000)
    test.assert_eq(int_or(ina226.reg_read(d, 0x03)), 4792)
    log_clear(c)
    let r = reading_or(ina226.reading_with_flags(d, 2000))
    test.assert_eq(r.reading.bus.mv, 11980)
    test.assert_eq(r.reading.shunt.uv, 20000)
    test.assert_eq(r.reading.current.ua, 10000000)
    test.assert_eq(r.reading.power.uw, 119800000)
    test.assert(not r.reading.overflow)
    // Six reads of one register each: CAL, SHUNT, BUS, CURRENT, POWER and
    // MASK/ENABLE last.
    log_is(c, [2, 0x40, 0x05, 2, -1, 2, 0x40, 0x01, 2, -1, 2, 0x40, 0x02, 2, -1,
               2, 0x40, 0x04, 2, -1, 2, 0x40, 0x03, 2, -1, 2, 0x40, 0x06, 2, -1])

@test
fn test_a_charging_battery_reads_a_negative_current_and_power_zero_or_up() [io, hw]
    let c = chip()
    let d = dut(c)
    example(c, d)
    // -20 mV across the shunt: -8000 steps, -10 A at a 1 mA step.
    c.regs.insert(0x01, 0xE0C0)
    match ina226.reading_of(d, 2000)
        Some(r) =>
            test.assert_eq(r.shunt.uv, -20000)
            test.assert_eq(r.current.ua, -10000000)
            // The Power register is unsigned, so it reads the magnitude.
            test.assert(r.power.uw > 0)
        None => test.assert(false)

@test
fn test_the_overflow_flag_gives_a_reading_with_no_current_or_power() [io, hw]
    let c = chip()
    let d = dut(c)
    example(c, d)
    c.st.insert(50, 0x0004)
    let r = reading_or(ina226.reading_with_flags(d, 2000))
    test.assert(r.reading.overflow)
    test.assert(r.flags.overflow)
    test.assert_eq(r.reading.current.ua, 0)
    test.assert_eq(r.reading.power.uw, 0)
    // The bus and shunt voltages are measurements all the same.
    test.assert_eq(r.reading.bus.mv, 11980)
    test.assert_eq(r.reading.shunt.uv, 20000)

@test
fn test_an_uncalibrated_part_has_no_reading() [io, hw]
    let c = chip()
    let d = dut(c)
    c.regs.insert(0x01, 8000)
    test.assert(ina226.reading_with_flags(d, 2000) == None)
    test.assert(ina226.reading_of(d, 2000) == None)
    // One read of the calibration, and no more.
    log_is(c, [2, 0x40, 0x05, 2, -1, 2, 0x40, 0x05, 2, -1])
    // The bus voltage needs no calibration.
    c.regs.insert(0x02, 9584)
    test.assert_eq(mv_or(ina226.bus_read(d)), 11980)
    log_is(c, [2, 0x40, 0x02, 2, -1])

@test
fn test_a_part_that_leaves_part_way_through_a_reading_gives_none() [io, hw]
    // After k answered reads the next is refused, for each of the six.
    for k in 0..6
        let c = chip()
        let d = dut(c)
        example(c, d)
        c.st.insert(41, k)
        test.assert(ina226.reading_with_flags(d, 2000) == None)

@test
fn test_the_flags_come_with_the_reading_and_clear_on_read() [io, hw]
    let c = chip()
    let d = dut(c)
    example(c, d)
    c.st.insert(50, 0x0018)
    let r = reading_or(ina226.reading_with_flags(d, 2000))
    test.assert(r.flags.alert)
    test.assert(r.flags.ready)
    test.assert(not r.flags.overflow)
    // The read cleared them.
    let f = flags_or(ina226.flags_read(d))
    test.assert(not f.alert)
    test.assert(not f.ready)

@test
fn test_conversion_ready_clears_when_read() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(not ina226.conversion_ready(d))
    c.st.insert(50, 0x0008)
    test.assert(ina226.conversion_ready(d))
    test.assert(not ina226.conversion_ready(d))

// ── Starting a conversion ────────────────────────────────────────────

@test
fn test_a_part_in_a_continuous_mode_converts_by_itself() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert_eq(ina226.convert_start(d), 0)
    // One read of CONFIG and nothing written.
    log_is(c, [2, 0x40, 0x00, 2, -1])

@test
fn test_a_triggered_conversion_writes_the_mode_and_answers_the_time() [io, hw]
    let c = chip()
    let d = dut(c)
    // 16 averages of 588 us on both signals: 16 * 1176 = 18816.
    test.assert(ina226.config_write(d, Ina226Config { avg: 2, vbus_ct: 3, vshunt_ct: 3, mode: 0 }))
    log_clear(c)
    test.assert_eq(ina226.convert_start(d), 18816)
    test.assert_eq(at(c.regs, 0x00), 0x4000 | (2 << 9) | (3 << 6) | (3 << 3) | 3)
    log_is(c, [2, 0x40, 0x00, 2, -1, 1, 0x40, 0x00, 0x44, 0xDB, -1, 2, 0x40, 0x00, 2, -1])

@test
fn test_a_triggered_mode_is_triggered_again() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(ina226.config_write(d, Ina226Config { avg: 0, vbus_ct: 4, vshunt_ct: 4, mode: 1 }))
    test.assert_eq(ina226.convert_start(d), 2200)
    test.assert_eq(config_or(ina226.config_read(d)).mode, 3)

@test
fn test_a_triggered_conversion_stops_when_the_write_fails() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(ina226.config_write(d, Ina226Config { avg: 0, vbus_ct: 4, vshunt_ct: 4, mode: 0 }))
    c.st.insert(42, 0)
    test.assert_eq(ina226.convert_start(d), -1)

// ── The alert ────────────────────────────────────────────────────────

@test
fn test_each_alert_function_sets_its_own_bit() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(ina226.alert_write(d, 1, false, false, false, 8000))
    test.assert_eq(at(c.regs, 0x07), 8000)
    test.assert_eq(at(c.regs, 0x06), 0x8000)
    test.assert(ina226.alert_write(d, 2, false, false, false, 8000))
    test.assert_eq(at(c.regs, 0x06), 0x4000)
    test.assert(ina226.alert_write(d, 3, false, false, false, 9584))
    test.assert_eq(at(c.regs, 0x06), 0x2000)
    test.assert(ina226.alert_write(d, 4, false, false, false, 9584))
    test.assert_eq(at(c.regs, 0x06), 0x1000)
    test.assert(ina226.alert_write(d, 5, false, false, false, 4792))
    test.assert_eq(at(c.regs, 0x06), 0x0800)
    test.assert_eq(at(c.regs, 0x07), 4792)
    test.assert(ina226.alert_write(d, 0, false, false, false, 0))
    test.assert_eq(at(c.regs, 0x06), 0x0000)

@test
fn test_the_alert_options_polarity_latch_and_conversion_ready() [io, hw]
    let c = chip()
    let d = dut(c)
    // Bus under-voltage, Conversion Ready also, active high, latched.
    test.assert(ina226.alert_write(d, 4, true, true, true, 9584))
    test.assert_eq(at(c.regs, 0x06), 0x1000 | 0x0400 | 0x0002 | 0x0001)
    // Conversion Ready alone.
    test.assert(ina226.alert_write(d, 0, true, false, false, 0))
    test.assert_eq(at(c.regs, 0x06), 0x0400)
    // Polarity alone, then latch alone.
    test.assert(ina226.alert_write(d, 0, false, true, false, 0))
    test.assert_eq(at(c.regs, 0x06), 0x0002)
    test.assert(ina226.alert_write(d, 0, false, false, true, 0))
    test.assert_eq(at(c.regs, 0x06), 0x0001)

@test
fn test_the_limit_is_written_before_the_function_is_enabled() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(ina226.alert_write(d, 1, false, false, false, 8000))
    log_is(c, [1, 0x40, 0x07, 0x1F, 0x40, -1, 2, 0x40, 0x07, 2, -1, 1, 0x40, 0x06, 0x80, 0x00, -1, 2, 0x40, 0x06, 2, -1])

@test
fn test_a_function_outside_the_range_is_refused_and_sends_nothing() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(not ina226.alert_write(d, 6, false, false, false, 0))
    test.assert(not ina226.alert_write(d, -1, false, false, false, 0))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_an_alert_the_part_does_not_hold_is_reported() [io, hw]
    let c = chip()
    let d = dut(c)
    // The limit register ignores the write: the function is not enabled.
    c.ro.insert(0x07, 1)
    test.assert(not ina226.alert_write(d, 1, false, false, false, 8000))
    test.assert_eq(at(c.regs, 0x06), 0)
    c.ro.insert(0x07, 0)
    c.ro.insert(0x06, 1)
    test.assert(not ina226.alert_write(d, 1, false, false, false, 8000))

@test
fn test_the_alert_reads_back_only_the_bits_that_are_stored() [io, hw]
    // The flag bits of Mask/Enable come and go; the read-back compares the
    // function and the two configuration bits.
    let c = chip()
    let d = dut(c)
    c.st.insert(50, 0x0018)
    test.assert(ina226.alert_write(d, 3, false, false, true, 9584))
    test.assert_eq(at(c.regs, 0x06), 0x2001)

// ── The device type over absent hardware ─────────────────────────────
//
// The host's handles are absent hardware: every transfer is refused, so
// each method answers its "no part" value.  This runs the lines of the type
// that forward to the functions above, and the guards of the trait methods.

@test
fn test_the_type_over_absent_hardware() [io, hw]
    let w = dev_bus.wiring_i2c(0, 0x40)
    let p = Ina226.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, w, 100000)
    test.assert_eq(p.shunt(), 100000)
    test.assert(not p.begin())
    test.assert(p.reg(0x00) == None)
    test.assert(p.calibration() == None)
    test.assert(p.reading() == None)
    test.assert(p.flags() == None)
    test.assert(not p.ready())
    test.assert(p.config() == None)
    test.assert(not p.set_config(Ina226Config { avg: 0, vbus_ct: 4, vshunt_ct: 4, mode: 7 }))
    test.assert(not p.set_averaging(1))
    test.assert(not p.set_conversion_times(1, 1))
    test.assert(not p.set_mode(3))
    test.assert(not p.set_alert(1, false, false, false, 100))
    test.assert_eq(p.alert_pin(), -1)
    test.assert(p.device_id() == None)

@test
fn test_the_current_monitor_over_absent_hardware() [io, hw]
    let w = dev_bus.wiring_i2c(0, 0x40)
    let p = Ina226.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, w, 100000)
    test.assert_eq(p.mon_channels(), 1)
    // A channel the part does not have, and a shunt other than the board's.
    test.assert(not p.mon_set_shunt(1, 100000, 800000))
    test.assert(not p.mon_set_shunt(-1, 100000, 800000))
    test.assert(not p.mon_set_shunt(0, 50000, 800000))
    // The board's shunt reaches the bus, which is absent.
    test.assert(not p.mon_set_shunt(0, 100000, 800000))
    test.assert(p.mon_read(1) == None)
    test.assert(p.mon_read(0) == None)
    test.assert(p.mon_bus_voltage(1) == None)
    test.assert(p.mon_bus_voltage(0) == None)
    test.assert_eq(p.mon_start(), -1)
    // A read after the wait gives the same answer as a read.
    test.assert(p.mon_read_after(0, 10, 100) == None)
    test.assert(p.mon_read_after(0, 100, 100) == None)
